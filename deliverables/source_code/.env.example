# ==============================================================================
# RFP Intelligence Platform — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Model Selection (Managed via LiteLLM)
# ------------------------------------------------------------------------------
# Choose any local or cloud model supported by LiteLLM:
#   - Local Ollama:      ollama/qwen3.5:4b, ollama/llama3.2:3b, ollama/mistral
#   - Google Gemini:     gemini/gemini-2.5-flash, gemini/gemini-2.0-flash
#   - OpenAI:            openai/gpt-4o-mini, openai/gpt-4o
#   - Anthropic:         anthropic/claude-3-5-sonnet-20241022, anthropic/claude-3-5-haiku-20241022
LLM_MODEL=gemini/gemini-2.5-flash
VALIDATOR_LLM_MODEL=gemini/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Cloud Provider API Keys (Fill in for your chosen provider)
# ------------------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. Local Ollama Settings (If using local models)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. Embedding Configuration
# ------------------------------------------------------------------------------
# Local Ollama:  ollama/qwen3-embedding:0.6b, ollama/nomic-embed-text
# Cloud Gemini:  gemini/text-embedding-004
# Cloud OpenAI:  openai/text-embedding-3-small
EMBEDDING_MODEL=ollama/qwen3-embedding:0.6b

# ------------------------------------------------------------------------------
# 5. Service Host & Port Configuration
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=8501

# ------------------------------------------------------------------------------
# 6. Storage & Processing Directories
# ------------------------------------------------------------------------------
VECTOR_DB_DIR=data/processed/chroma
PROCESSED_DATA_DIR=data/processed
OUTPUTS_DIR=../../deliverables/outputs
COMPANY_PROFILE_PATH=data/company_capabilities.json

# ------------------------------------------------------------------------------
# 7. Agent & RAG Pipeline Controls
# ------------------------------------------------------------------------------
TOP_K_RETRIEVAL=5
MAX_VALIDATION_RETRIES=2
ENABLE_SEMANTIC_CACHE=true
LOG_LEVEL=INFO